# Export these into the process environment; Spring does not load this file automatically.
DB_URL=jdbc:postgresql://127.0.0.1:5432/algoventure
DB_USER=algoventure
DB_PASSWORD=replace-with-your-database-password
COOKIE_SECURE=true
SEED_ENABLED=false
# Optional internal adaptive service; leave empty until configured.
AI_SERVICE_URL=http://127.0.0.1:8090
# Only for explicit initial development/bootstrap provisioning:
# SEED_ENABLED=true
# SEED_ADMIN_PASSWORD=replace-with-at-least-10-characters
# SEED_INSTRUCTOR_PASSWORD=replace-with-at-least-10-characters
